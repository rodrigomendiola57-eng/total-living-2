# Entorno local Docker (estable)
ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=total_living.settings.development
DEBUG=True
APP_PORT=8090
SERVE_LOCAL_MEDIA=True

SECRET_KEY=replace-with-local-dev-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
ADMIN_URL_PATH=gestion-total-living-2026/
PANEL_URL_PATH=acceso-interno-staff-2026/
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
ENFORCE_STRONG_SECRET_KEY=False

POSTGRES_DB=total_living
POSTGRES_USER=total_living
POSTGRES_PASSWORD=replace-with-local-db-password
DATABASE_URL=postgresql://total_living:replace-with-local-db-password@db:5432/total_living

# Opcional: Redis local para probar rate limits como en prod (vacío = LocMem)
REDIS_URL=

USE_S3=False
USE_OBJECT_STORAGE=False
OBJECT_STORAGE_PROVIDER=aws
USE_S3_STATIC=False
USE_S3_MEDIA=False
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=900
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_BASE_URL=

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=replace-with-email-password
DEFAULT_FROM_EMAIL=no-reply@example.com

PANEL_LOGIN_RATELIMIT_IP=15/15m
PANEL_LOGIN_RATELIMIT_USERNAME=8/15m
CONTACT_FORM_RATELIMIT_IP=5/h

MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
MAP_TILE_SUBDOMAINS=abcd
MAP_TILE_MAX_ZOOM=20

# Startup behavior (dev)
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=0
RUN_SEED_DEMO_CATALOG=1
GUNICORN_RELOAD=1
DEV_LIVE_RELOAD=1

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=90
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
