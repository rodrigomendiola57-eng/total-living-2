# =============================================================================
# Staging — Mini-C (espejo real: HTTPS + RDS + S3)
# Copia a .env en el servidor de staging o exporta estas variables allí.
# ENVIRONMENT=staging activa total_living/settings/staging.py (hereda production).
# =============================================================================

# En el proceso WSGI (Gunicorn, etc.) debe estar:
#   DJANGO_SETTINGS_MODULE=total_living.settings.staging
# (manage.py en local sigue usando development salvo que lo cambies al invocar.)
ENVIRONMENT=staging
DEBUG=False

SECRET_KEY=replace-with-staging-secret-min-50-chars-random
ALLOWED_HOSTS=staging.tudominio.com
CSRF_TRUSTED_ORIGINS=https://staging.tudominio.com

ADMIN_URL_PATH=gestion-total-living-2026/
PANEL_URL_PATH=acceso-interno-staff-2026/

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
ENFORCE_STRONG_SECRET_KEY=True

DATABASE_URL=postgresql://user:password@staging-rds.region.rds.amazonaws.com:5432/total_living_staging

REDIS_URL=

USE_OBJECT_STORAGE=True
OBJECT_STORAGE_PROVIDER=aws
USE_S3_STATIC=True
USE_S3_MEDIA=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=total-living-staging
# Puede ser bucket dedicado staging o el mismo de prod solo en pruebas controladas:
# totalliving-media-s3-prod-rm-us-east-1-001
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_STATIC_LOCATION=static
AWS_MEDIA_LOCATION=media
SERVE_LOCAL_MEDIA=False

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
MAP_TILE_SUBDOMAINS=abcd
MAP_TILE_MAX_ZOOM=20
