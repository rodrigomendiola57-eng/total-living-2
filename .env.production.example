# =========================
# Entorno de producción
# =========================
ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=total_living.settings.production
DEBUG=False
APP_PORT=8090
# En producción real con S3 para media: False. Solo True para depuración local sin bucket.
SERVE_LOCAL_MEDIA=False

# =========================
# Seguridad Django
# =========================
SECRET_KEY=replace-with-a-very-long-random-secret
ALLOWED_HOSTS=example.com,www.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com,http://localhost:8090,http://127.0.0.1:8090
# Dominio público para enlaces al compartir (WhatsApp, etc.). Sin barra final.
PUBLIC_SITE_URL=https://www.example.com
ADMIN_URL_PATH=gestion-total-living-2026/
PANEL_URL_PATH=acceso-interno-staff-2026/
# En AWS con HTTPS detrás de ALB/CloudFront: True (recomendado).
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
ENFORCE_STRONG_SECRET_KEY=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# =========================
# Base de datos (Docker local / Lightsail)
# =========================
POSTGRES_DB=total_living
POSTGRES_USER=total_living
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgresql://total_living:replace-with-strong-db-password@db:5432/total_living

# =========================
# Caché (Redis recomendado en producción para rate limits multi-worker)
# =========================
# Ejemplo: redis://:password@redis-host:6379/0
REDIS_URL=

# =========================
# Object storage — Amazon S3 (Total Living)
# Proyecto SIM (otro repo): bucket típico sim-icasa-media; no aplica a este código.
# =========================
# Activar en servidor: USE_OBJECT_STORAGE=True (o USE_S3_MEDIA / USE_S3_STATIC por separado).
USE_S3=False
USE_OBJECT_STORAGE=False
OBJECT_STORAGE_PROVIDER=aws
USE_S3_STATIC=False
USE_S3_MEDIA=False
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=900
# Credenciales IAM (opcional en EC2 si usas perfil de instancia; deja vacío y asume rol).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket existente Total Living (prod):
AWS_STORAGE_BUCKET_NAME=totalliving-media-s3-prod-rm-us-east-1-001
AWS_S3_REGION_NAME=us-east-1
# Opcional: endpoint custom (MinIO, etc.)
AWS_S3_ENDPOINT_URL=
# Opcional: dominio CloudFront u otro CNAME del bucket
AWS_S3_CUSTOM_DOMAIN=
AWS_STATIC_LOCATION=static
AWS_MEDIA_LOCATION=media

# Alternativa: Cloudflare R2 (API S3). Usa OBJECT_STORAGE_PROVIDER=r2 y variables R2_*.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=

# Video /nosotros/ (opcional). Con WhiteNoise basta collectstatic; si usas R2 static, o URL pública del .mp4:
# https://<account>.r2.cloudflarestorage.com/<bucket>/static/videos/nosotros-hero.mp4
NOSOTROS_HERO_VIDEO_URL=

# =========================
# Email SMTP
# =========================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=replace-with-email-password
DEFAULT_FROM_EMAIL=no-reply@example.com

# =========================
# Rate limiting
# =========================
PANEL_LOGIN_RATELIMIT_IP=15/15m
PANEL_LOGIN_RATELIMIT_USERNAME=8/15m
CONTACT_FORM_RATELIMIT_IP=5/h

# =========================
# Gunicorn (rendimiento)
# =========================
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=90
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5

# =========================
# Mapa (opcional)
# =========================
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
MAP_TILE_SUBDOMAINS=abcd
MAP_TILE_MAX_ZOOM=20
